msgid "the spec must be a JSON object"
msgstr "la spécification doit être un objet JSON"

msgid "'title' must be a string"
msgstr "« title » doit être une chaîne"

msgid "'sessions' must be a non-empty list"
msgstr "« sessions » doit être une liste non vide"

msgid "session %(index)d must be an object"
msgstr "la session %(index)d doit être un objet"

msgid "session %(index)d: 'command' must be a string"
msgstr "session %(index)d : « command » doit être une chaîne"

msgid "session %(index)d: 'outputs' must be a list"
msgstr "session %(index)d : « outputs » doit être une liste"

msgid "session %(index)d output %(offset)d: '%(field)s' must be a string"
msgstr "session %(index)d, sortie %(offset)d : « %(field)s » doit être une chaîne"

msgid "usage: %(prog)s [-l CODE] SPEC.json [OUTPUT.svg]"
msgstr "utilisation : %(prog)s [-l CODE] SPEC.json [OUTPUT.svg]"

msgid "Render a terminal session as an animated SVG."
msgstr "Rendre une session de terminal sous forme d'un SVG animé."

msgid "options:"
msgstr "options :"

msgid "  -l, --lang CODE  output language"
msgstr "  -l, --lang CODE  langue de sortie"

msgid "  -h, --help       show this help"
msgstr "  -h, --help       afficher cette aide"

msgid "languages: %(languages)s"
msgstr "langues : %(languages)s"

msgid "no catalogue for %(code)s, using English"
msgstr "pas de catalogue pour %(code)s, sortie en anglais"

msgid "option %(option)s needs a language code"
msgstr "l'option %(option)s attend un code de langue"

msgid "unknown argument: %(arg)s"
msgstr "argument inconnu : %(arg)s"

msgid "missing spec file"
msgstr "fichier de spécification manquant"

msgid "wrote: %(path)s"
msgstr "écrit : %(path)s"
